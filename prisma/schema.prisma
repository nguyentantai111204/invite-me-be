datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN

  @@map("user_role")
}

enum InvitationEventType {
  WEDDING
  BIRTHDAY
  ANNIVERSARY
  PARTY
  CORPORATE

  @@map("invitation_event_type")
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("invitation_status")
}

model User {
  id                 String       @id @default(uuid()) @db.Uuid
  email              String       @unique @db.VarChar(255)
  passwordHash       String?      @map("password_hash") @db.VarChar(255)
  fullName           String       @map("full_name") @db.VarChar(100)
  avatarUrl          String?      @map("avatar_url") @db.VarChar(500)
  role               UserRole     @default(USER)
  isVerified         Boolean      @default(false) @map("is_verified")
  hashedRefreshToken String?      @map("hashed_refresh_token") @db.VarChar(255)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  invitations        Invitation[]

  @@map("users")
}

model Template {
  id               String       @id @default(uuid()) @db.Uuid
  slug             String       @unique @db.VarChar(100)
  title            String       @db.VarChar(150)
  description      String?      @db.Text
  category         String       @db.VarChar(50)
  thumbnailUrl     String       @map("thumbnail_url") @db.VarChar(500)
  previewSlug      String?      @map("preview_slug") @db.VarChar(100)
  isPremium        Boolean      @default(false) @map("is_premium")
  isPopular        Boolean      @default(false) @map("is_popular")
  tags             String[]     @default([])
  themeConfig      Json         @map("theme_config")
  sampleData       Json?        @map("sample_data")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  invitations      Invitation[]

  @@index([category])
  @@map("templates")
}

model Invitation {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String?              @map("user_id") @db.Uuid
  templateId         String?              @map("template_id") @db.Uuid
  slug               String               @unique @db.VarChar(100)
  title              String               @db.VarChar(200)
  description        String?              @db.Text
  eventType          InvitationEventType  @default(WEDDING) @map("event_type")
  status             InvitationStatus     @default(DRAFT)
  
  // Thời gian & Media chính
  eventDate          DateTime             @map("event_date") @db.Timestamptz
  eventTime          String               @map("event_time") @db.VarChar(50)
  coverImage         String               @map("cover_image") @db.VarChar(500)
  ogImage            String               @map("og_image") @db.VarChar(500)
  
  // Cấu hình Theme & Sections (Json Document)
  documentVersion    Int                  @default(1) @map("document_version")
  themeConfig        Json                 @map("theme_config")
  sectionVisibility  Json                 @map("section_visibility")
  sectionOrder       String[]             @default([]) @map("section_order")
  
  // Dữ liệu chi tiết các module
  coupleData         Json?                @map("couple_data")
  locationData       Json                 @map("location_data")
  scheduleData       Json                 @default("[]") @map("schedule_data")
  galleryData        String[]             @default([]) @map("gallery_data")
  bankAccountsData   Json                 @default("[]") @map("bank_accounts_data")
  
  // RSVP & Bảo mật
  rsvpEnabled        Boolean              @default(true) @map("rsvp_enabled")
  rsvpConfig         Json?                @map("rsvp_config")
  passwordHash       String?              @map("password_hash") @db.VarChar(255)
  
  // Xuất bản & Hết hạn
  publishedAt        DateTime?            @map("published_at") @db.Timestamptz
  draftExpiresAt     DateTime?            @map("draft_expires_at") @db.Timestamptz
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  template           Template?            @relation(fields: [templateId], references: [id], onDelete: SetNull)
  rsvps              Rsvp[]

  @@index([userId])
  @@index([slug])
  @@index([status])
  @@map("invitations")
}

model Rsvp {
  id                   String       @id @default(uuid()) @db.Uuid
  invitationId         String       @map("invitation_id") @db.Uuid
  guestName            String       @map("guest_name") @db.VarChar(100)
  phoneNumber          String?      @map("phone_number") @db.VarChar(20)
  attending            Boolean      @default(true)
  numberOfGuests       Int          @default(1) @map("number_of_guests")
  dietaryRequirements String?      @map("dietary_requirements") @db.VarChar(255)
  wishes               String?      @db.Text
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz

  invitation           Invitation   @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("rsvps")
}