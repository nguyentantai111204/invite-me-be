{
    "name": "invite-me-be",
    "version": "0.1.0",
    "description": "InviteMe Backend API - NestJS & Prisma",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\"",
        "start": "nest start",
        "dev": "nest start --watch",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "prisma:generate": "prisma generate --schema=prisma/schema",
        "prisma:migrate": "prisma migrate dev --schema=prisma/schema",
        "prisma:studio": "prisma studio --schema=prisma/schema",
        "prisma:deploy": "prisma migrate deploy --schema=prisma/schema"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.11",
        "@nestjs/config": "^4.0.1",
        "@nestjs/core": "^11.0.11",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.11",
        "@nestjs/swagger": "^11.0.6",
        "@prisma/client": "^6.4.1",
        "argon2": "^0.41.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "cloudinary": "^2.11.0",
        "cookie-parser": "^1.4.7",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.5",
        "@nestjs/schematics": "^11.0.2",
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "^5.0.0",
        "@types/multer": "^2.2.0",
        "@types/node": "^22.13.9",
        "@types/passport-jwt": "^4.0.1",
        "@typescript-eslint/eslint-plugin": "^8.68.0",
        "@typescript-eslint/parser": "^8.68.0",
        "eslint": "^9.21.0",
        "prettier": "^3.5.3",
        "prisma": "^6.4.1",
        "source-map-support": "^0.5.21",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.68.0"
    },
    "prisma": {
        "schema": "prisma/schema",
        "seed": "ts-node prisma/seed.ts"
    }
}
