PORT=3001
NODE_ENV=development
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inviteme_db?schema=public"

# JWT Authentication
JWT_ACCESS_SECRET="your-super-secret-access-key-minimum-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-minimum-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Secret
COOKIE_SECRET="cookie-secret-for-inviteme-session"